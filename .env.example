# ==========================================
# SERPAPI INDIA HACKATHON 2026 - ENVIRONMENT CONFIG
# ==========================================

# Obtain your SerpApi key for free from: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_api_key_here

# (Optional) LLM Provider API Keys (if building AI Agents / RAG)
# Google Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application Configuration
APP_ENV=development
PORT=8000
HOST=127.0.0.1

# ==========================================
# S2S TUNING (all optional - defaults shown)
# ==========================================

# Replay recorded SerpApi responses from fixtures/serpapi/ instead of calling
# the API. Read-only and never expires, so a demo cannot spend a credit.
S2S_DEMO_MODE=false

# Hard ceiling on SerpApi searches per run. The planner stops at this number.
S2S_CREDIT_CAP=12

# How many platforms one run may search, chosen by discipline affinity.
S2S_MAX_PLATFORMS=5

# Competencies grouped into one search. Each group searches with the phrase
# its members share most, so higher = fewer searches but broader queries.
S2S_TERMS_PER_DORK=3

# Maximum competencies extracted from one syllabus.
S2S_MAX_COMPETENCIES=6

# How long a cached SerpApi response stays valid.
S2S_CACHE_TTL_HOURS=72

# Include Upwork / Freelancer / Contra. They gate their detail pages and their
# Google index goes stale, so they are the main source of dead links.
S2S_INCLUDE_TIER_C=false

# How many results get a free liveness check (plain HTTP, no SerpApi credit).
# Runs in demo mode too and fails soft to "unverified" when offline. 0 = off.
S2S_PROBE_TOP_N=40
